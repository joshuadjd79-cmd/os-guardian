# OS Guardian - Comprehensive .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & Secrets (Never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.pkcs12
*.pfx
*.cert
*.crt

# System & OS Specific
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary & Local State
*.tmp
*.log
backend/*.db
